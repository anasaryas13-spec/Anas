local genv = (getgenv and getgenv()) or _G or {}

if type(genv.__XENO_CLEANUP) == "function" then pcall(genv.__XENO_CLEANUP) end

genv.__XENO_SESSION = (tonumber(genv.__XENO_SESSION) or 0) + 1
